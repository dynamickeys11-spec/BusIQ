VITE_SUPABASE_URL=https://nmkyclxahjsvikheinbv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-busiq-supabase-publishable-key

# Server-side model provider. For zero-cost remote development/testing, Groq is supported.
# Groq: https://api.groq.com/openai/v1
BUSIQ_MODEL_PROVIDER=groq
BUSIQ_MODEL_BASE_URL=https://api.groq.com/openai/v1
BUSIQ_MODEL_NAME=openai/gpt-oss-120b
# Never expose this as VITE_* or put it in browser code.
BUSIQ_MODEL_API_KEY=replace-with-groq-api-key

# Optional local development alternative:
# BUSIQ_MODEL_PROVIDER=ollama
# BUSIQ_MODEL_BASE_URL=http://localhost:11434/v1
# BUSIQ_MODEL_NAME=mistral
# BUSIQ_MODEL_API_KEY=optional

# Server-only secrets. Never expose these as VITE_* variables.
# SUPABASE_SECRET_KEY=sb_secret_...
# BUSIQ_ACTION_WEBHOOK_URL=https://your-controlled-https-endpoint.example/actions
# BUSIQ_ACTION_WEBHOOK_SECRET=replace-with-action-webhook-secret

